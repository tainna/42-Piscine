#include<string.h>

size_t	ft_strcspn(const char *s, const char *reject)
{
    size_t i = 0;
    size_t b = 0;
    
    while(s[i])
    {
        b = 0;
        while(reject[b])
        {
            if(s[i] == reject[b])
                return(i);
            b++;
        }
        i++;
    } 
}
